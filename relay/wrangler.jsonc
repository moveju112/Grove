{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grove-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-04-07",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "GroveRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GroveRelay"] }],
  "observability": { "enabled": false }
}
